  </section>


  <!-- OPTIONS -->

  <section>

    <div class="wrap">

      <div class="eyebrow">
        WYBIERZ SWÓJ WARIANT
      </div>

      <h2>
        Sala albo całe przyjęcie.
      </h2>

      <div class="options">

        <article class="option">

          <h3>
            Wynajem sali
          </h3>

          <p>
            Organizujesz przyjęcie
            po swojemu i możesz
            skorzystać z własnego
            cateringu.
          </p>

          <strong>
            od 1400 zł
          </strong>

        </article>


        <article
          class="option option-highlight"
        >

          <h3>
            Przyjęcie z obsługą
          </h3>

          <p>
            Możliwość organizacji
            przyjęcia z obsługą
            i cateringiem do 45 osób,
            bez dodatkowej opłaty
            za wynajem sali.
          </p>

          <strong>
            od 150 zł / os.
          </strong>

        </article>

      </div>

    </div>

  </section>


  <!-- LIGHT SHOW -->

  <section class="party">

    <div class="wrap">

      <div class="eyebrow">
        PO ZMROKU
      </div>

      <h2>
        A kiedy zaczyna się
        impreza...
      </h2>

      <p class="lead"
         style="color:white">
        Przestrzeń zmienia
        swój charakter.
      </p>

    </div>

  </section>


  <!-- GALLERY -->

  <section id="galeria">

    <div class="wrap">

      <div class="eyebrow">
        GALERIA
      </div>

      <h2>
        Tu zaczynają się wspólne chwile.
      </h2>

      <div class="gallery">

        {
          gallery.map(
            (image, index) => (

              <img
                src={image.src}
                alt={image.alt}
                loading={
                  index < 2
                    ? 'eager'
                    : 'lazy'
                }
              />

            )
          )
        }

      </div>

    </div>

  </section>


  <!-- CONTACT -->

  <section
    class="contact"
    id="kontakt"
  >

    <div class="wrap">

      <div class="contact-content">

        <div class="eyebrow">
          REZERWACJA
        </div>

        <h2>
          Twój termin może być
          jeszcze wolny.
        </h2>

        <p class="lead"
           style="color:rgba(255,255,255,.78)">
          Najbliższe terminy szybko
          się kończą. Zadzwoń
          i zapytaj o dostępność.
        </p>

        <a
          class="phone"
          href={`tel:${phoneLink}`}
        >
          {phoneDisplay}
        </a>

        <p>
          Sala „Nad Jasieniem”<br />
          Al. Politechniki 31<br />
          93-557 Łódź
        </p>

<a
  class="button"
  href={`tel:${phoneLink}`}
>
  <span>Zadzwoń i zapytaj o termin</span>
  <span class="button-arrow">→</span>
</a>

      </div>

    </div>

  </section>

</main>


<footer>
  <div class="wrap footer-content">

    <div class="footer-brand">
      Sala „Nad Jasieniem”
    </div>

    <div class="footer-meta">
      © 2025 · Łódź
      <span class="footer-dot">·</span>
      Designed & built by
      <span class="designer"> GeorgEudezet</span>
    </div>

  </div>
</footer>


<a
  class="mobile-call"
  href={`tel:${phoneLink}`}
>
  Zadzwoń · {phoneDisplay}
</a>


</body>
</html>