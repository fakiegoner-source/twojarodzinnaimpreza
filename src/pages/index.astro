---
const phoneDisplay = '795 309 108';
const phoneLink = '+48795309108';

const gallery = [
  {
    src: '/images/sala_dekoracja.jpg',
    alt: 'Sala Nad Jasieniem przygotowana na przyjęcie'
  },
  {
    src: '/images/sala_swiatla.jpg',
    alt: 'Sala Nad Jasieniem z oświetleniem imprezowym'
  },
  {
    src: '/images/sala-stoly.jpg',
    alt: 'Ustawienie stołów w sali Nad Jasieniem'
  },
  {
    src: '/images/sala-przestrzen.jpg',
    alt: 'Przestrzeń sali Nad Jasieniem'
  },
  {
    src: '/images/sala-wnetrze.jpg',
    alt: 'Wnętrze sali Nad Jasieniem'
  },
  {
    src: '/images/sala-bar.jpg',
    alt: 'Część barowa sali Nad Jasieniem'
  }
];
---

<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Sala na imprezy Łódź | Nad Jasieniem</title>

  <meta
    name="description"
    content="Kameralna sala na imprezy w Łodzi do 33 osób. Urodziny, chrzciny, komunie, spotkania rodzinne i firmowe. Wynajem sali Nad Jasieniem."
  />

  <style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Nunito+Sans:wght@400;500;600;700;800&display=swap');
    :root {
      --cream: #f6f2e9;
      --cream-dark: #ece5d8;
      --white: #ffffff;

      --green: #173e35;
      --green-light: #24594c;
      --green-soft: #dce8df;

      --gold: #c69a5d;
      --gold-light: #ead6b7;

      --ink: #20221f;
      --muted: #6f726d;
      --border: rgba(23, 62, 53, 0.13);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font-family: 'Nunito Sans', sans-serif;
      line-height: 1.65;
    }

    img {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
    }

    .wrap {
      width: min(1180px, 92%);
      margin: 0 auto;
    }

    /* NAVIGATION */

    header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;

      background: rgba(246, 242, 233, 0.92);
      backdrop-filter: blur(14px);

      border-bottom: 1px solid var(--border);
    }

    .nav {
      min-height: 70px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;
    }

    .brand {
      text-decoration: none;

      color: var(--green);

      font-family: 'Nunito Sans', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .navigation {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .navigation a {
      text-decoration: none;
      font-weight: 700;
      font-size: 0.92rem;
    }

    /* BUTTONS */

    .button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 16px;

  min-height: 54px;
  padding: 0 26px;

  border-radius: 14px;

  background: linear-gradient(
    135deg,
    #d49a43,
    #b9782e
  );

  color: #fffaf2 !important;

  text-decoration: none;
  font-weight: 800;

  box-shadow:
    0 8px 25px rgba(198, 154, 93, 0.28),
    0 0 25px rgba(198, 154, 93, 0.12);

  transition:
    transform .25s ease,
    box-shadow .25s ease,
    filter .25s ease;
}

.button:hover {
  transform: translateY(-3px);

  filter: brightness(1.07);

  box-shadow:
    0 12px 34px rgba(198, 154, 93, 0.38),
    0 0 30px rgba(198, 154, 93, 0.20);
}
.button-arrow {
  display: inline-block;
  font-size: 1.35rem;
  line-height: 1;
  transition: transform .25s ease;
}

.button:hover .button-arrow {
  transform: translateX(6px);
}


    .button-green {
      background: var(--green);
      color: white;
    }

    .button-light {
      background: white;
      color: var(--green) !important;
    }

    /* HERO */

    .hero {
      position: relative;

      min-height: 92vh;

      display: flex;
      align-items: flex-end;

      overflow: hidden;

      color: white;

      background:
        linear-gradient(
          180deg,
          rgba(10, 22, 18, 0.08) 10%,
          rgba(10, 26, 21, 0.30) 48%,
          rgba(10, 28, 22, 0.91) 100%
        ),
        url('/images/sala_dekoracja.jpg')
        center / cover no-repeat;
    }

    /* SUBTELNY BŁYSK */

    .hero::before {
      content: "";

      position: absolute;

      width: 800px;
      height: 800px;

      left: -220px;
      bottom: -350px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(198, 154, 93, 0.32) 0%,
          rgba(198, 154, 93, 0.12) 34%,
          transparent 70%
        );

      filter: blur(20px);

      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 2;

      padding: 150px 0 80px;

      max-width: 900px;
    }

    .eyebrow {
      display: flex;
      align-items: center;

      gap: 10px;

      text-transform: uppercase;

      font-size: 0.78rem;
      font-weight: 900;

      letter-spacing: 0.18em;

      color: var(--gold-light);
    }

    .spark {
      color: var(--gold);

      font-size: 1.4rem;

      animation: sparkle 3s ease-in-out infinite;
    }

    @keyframes sparkle {

      0%,
      100% {
        opacity: 0.55;
        transform: scale(0.85);
      }

      50% {
        opacity: 1;
        transform: scale(1.15);

        text-shadow:
          0 0 12px rgba(234, 214, 183, 0.9),
          0 0 30px rgba(198, 154, 93, 0.7);
      }
    }

    h1 {
      max-width: 900px;

      margin: 0.18em 0;

  font-family: 'DM Serif Display', Georgia, serif;
  font-weight: 400;

      font-size: clamp(3.2rem, 8vw, 7rem);

      line-height: 0.94;
      letter-spacing: -0.04em;
    }

    .hero-description {
      max-width: 620px;

      margin: 22px 0 0;

      font-size: clamp(1.05rem, 2vw, 1.3rem);

      color: rgba(255, 255, 255, 0.90);
    }

    .hero-price {
      margin: 22px 0 0;

      font-weight: 800;
      color: var(--gold-light);
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;

      gap: 12px;

      margin-top: 28px;
    }

    /* GENERAL */

    section {
      padding: 100px 0;
    }

    h2 {
      margin: 10px 0 25px;

      color: var(--green);

      font-family: 'DM Serif Display', Georgia, serif;
  font-weight: 400;

      font-size: clamp(2.4rem, 5vw, 4.6rem);

      line-height: 1.03;
      letter-spacing: -0.035em;
    }

    h3 {
      color: var(--green);

      font-family: 'Nunito Sans', sans-serif;

      font-size: 1.4rem;
    }

    .lead {
      max-width: 760px;

      font-size: 1.25rem;

      color: #494d48;
    }

    /* BENEFITS */

    .benefits {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 14px;

      margin-top: 45px;
    }

    .benefit {
      padding: 30px 25px;

      background: white;

      border: 1px solid var(--border);

      border-radius: 22px;

      box-shadow:
        0 12px 40px rgba(30, 46, 40, 0.04);
    }

    .benefit-number {
      display: block;

      margin-bottom: 8px;

      color: var(--gold);

      font-family: 'Nunito Sans', sans-serif;
      font-size: 2.7rem;
      font-weight: 700;
    }

    /* SPLIT IMAGE SECTION */

    .split {
      display: grid;

      grid-template-columns: 1.2fr 0.8fr;

      align-items: center;

      gap: 60px;
    }

    .split-image {
      width: 100%;
      height: 620px;

      object-fit: cover;

      border-radius: 26px;
    }

    .checklist {
      list-style: none;

      padding: 0;

      margin: 30px 0;
    }

    .checklist li {
      margin: 12px 0;

      font-weight: 650;
    }

    .checklist li::before {
      content: "✓";

      margin-right: 12px;

      color: var(--gold);

      font-weight: 900;
    }
/* JASIEN WAVE TRANSITION */

.jasien-transition {
  position: relative;
  height: 140px;
  overflow: hidden;
  background: var(--cream);
}

.jasien-wave {
  position: relative;
  width: 100%;
  height: 100%;
}

.jasien-label {
  position: absolute;
  z-index: 3;

  top: 18px;
  left: 50%;
  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 10px;

  white-space: nowrap;

  color: var(--green);

  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.22em;
}

.jasien-label span {
  color: var(--gold);
}

.wave-svg {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0px;

  width: 100%;
  height: 100px;
}

.wave-line {
  fill: none;
  stroke-linecap: round;
}

.wave-line-green {
  stroke: var(--green);
  stroke-width: 1.5;
  opacity: 0.3;
}

.wave-line-gold {
  stroke: var(--gold);
  stroke-width: 1.5;
  opacity: 0.65;

  stroke-dasharray: 7 9;

  animation: waveFlow 9s linear infinite;
}

@keyframes waveFlow {
  to {
    stroke-dashoffset: -130;
  }
}

.wave-dot {
  position: absolute;

  left: 50%;
  bottom: 39px;

  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: var(--gold);

  box-shadow:
    0 0 8px rgba(198,154,93,.85),
    0 0 20px rgba(198,154,93,.45);

  animation: waterLight 5s ease-in-out infinite;
}

@keyframes waterLight {

  0% {
    transform: translateX(-140px) scale(.8);
    opacity: .3;
  }

  50% {
    transform: translateX(140px) scale(1.25);
    opacity: 1;
  }

  100% {
    transform: translateX(-140px) scale(.8);
    opacity: .3;
  }
}
    /* PRICE SECTION */

    .pricing {
      background: var(--green);

      color: white;
    }

    .pricing h2 {
      color: white;
    }

    .pricing .eyebrow {
      color: var(--gold-light);
    }

    .price-grid {
      display: grid;

      grid-template-columns: repeat(2, 1fr);

      gap: 18px;

      margin-top: 45px;
    }

    .price-card {
      padding: 38px;

      border: 1px solid rgba(255, 255, 255, 0.17);

      border-radius: 24px;

      background: rgba(255, 255, 255, 0.075);
    }

    .price {
      margin: 10px 0;

      color: var(--gold-light);

      font-family: 'Nunito Sans', sans-serif;

      font-size: clamp(3rem, 7vw, 5rem);

      line-height: 1;
    }

    .price-card p {
      color: rgba(255,255,255,.78);
    }

    .included {
      margin-top: 50px;

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 12px;
    }

    .included div {

      padding: 18px;

      border-top: 1px solid
        rgba(255,255,255,.20);

      font-weight: 700;
    }

    /* OPTIONS */

    .options {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 20px;

      margin-top: 40px;
    }

    .option {
      padding: 40px;

      border-radius: 25px;

      background: white;

      border: 1px solid var(--border);
    }

    .option-highlight {
      background: var(--green-soft);
    }

    /* PARTY IMAGE */

    .party {
      min-height: 70vh;

      display: flex;
      align-items: flex-end;

      color: white;

      background:
        linear-gradient(
          180deg,
          rgba(0,0,0,.05),
          rgba(8,19,16,.85)
        ),
        url('/images/sala_swiatla.jpg')
        center / cover no-repeat;
    }

    .party h2 {
      max-width: 700px;
      color: white;
    }

    /* GALLERY */

    .gallery {
      display: grid;

      grid-template-columns:
        2fr 1fr 1fr;

      grid-auto-rows: 260px;

      gap: 12px;

      margin-top: 40px;
    }

    .gallery img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      border-radius: 18px;
    }

    .gallery img:first-child {
      grid-row: span 2;
    }

    /* CONTACT */

    .contact {
      position: relative;

      overflow: hidden;

      background: var(--green);

      color: white;
    }

    .contact::after {
      content: "";

      position: absolute;

      width: 650px;
      height: 650px;

      right: -250px;
      top: -280px;

      background:
        radial-gradient(
          circle,
          rgba(198,154,93,.30),
          transparent 68%
        );
    }

    .contact-content {
      position: relative;
      z-index: 2;

      max-width: 850px;
    }

    .contact h2 {
      color: white;
    }

    .phone {
      display: block;

      margin: 25px 0;

      color: var(--gold-light);

      text-decoration: none;

      font-family: 'Nunito Sans', sans-serif;

      font-size: clamp(2.6rem, 6vw, 4.5rem);

      font-weight: 700;

      line-height: 1;
    }

    footer {
      padding: 35px 0;

      background: #102a23;

      color: rgba(255,255,255,.65);
    }
    .footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
}

.footer-brand {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: white;
}

.footer-meta {
  font-size: 0.78rem;
  letter-spacing: 0.04em;
  color: rgba(255,255,255,.55);
}

.designer {
  color: var(--gold-light);
}

.footer-dot {
  margin: 0 6px;
}

    .mobile-call {
      display: none;
    }

    @media (max-width: 900px) {

      .benefits {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .split {
        grid-template-columns: 1fr;
      }

      .split-image {
        height: 450px;
      }

      .included {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media (max-width: 700px) {

      section {
        padding: 75px 0;
      }

      .navigation a:not(.button) {
        display: none;
      }

      .hero {
        min-height: 82vh;
      }

      .benefits,
      .price-grid,
      .options {
        grid-template-columns: 1fr;
      }

      .gallery {
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: 190px;
      }

      .gallery img:first-child {
        grid-column: span 2;
        grid-row: auto;

        height: 310px;
      }

      .mobile-call {
        display: block;

        position: fixed;

        z-index: 200;

        bottom: 14px;
        left: 4%;
        right: 4%;

        padding: 15px;

        border-radius: 999px;

        background: #b9823f;
        color: #fffaf2 !important;

        text-align: center;
        text-decoration: none;

        font-weight: 900;

        box-shadow:
          0 10px 35px rgba(0,0,0,.30);
      }
.jasien-transition {
  height: 135px;
}

.jasien-label {
  top: 18px;
  font-size: 0.65rem;
}

.wave-svg {
  height: 95px;
  bottom: 8px;
}

.wave-dot {
  bottom: 44px;
}
    }
  </style>
</head>

<body>

<header>
